# Google Analytics 4 (public ID, also hardcoded in app/layout.tsx). Optional — code falls back to G-G8SDGNWZEB.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Resend: Lead-Mails per /api/lead. Domain ki-kanzlei.at in Resend verifizieren.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
LEAD_TO_EMAIL=info@ki-kanzlei.at
LEAD_FROM_EMAIL=KI Kanzlei <leads@ki-kanzlei.at>

# Blog-Route /api/blog/create (n8n -> GitHub). Owner/Repo defaulten im Code auf ki-kanzlei-at/ki-kanzlei.
N8N_API_SECRET=your_shared_secret
GITHUB_TOKEN=github_pat_with_contents_write
# GITHUB_OWNER=ki-kanzlei-at
# GITHUB_REPO=ki-kanzlei
# GITHUB_BRANCH=main
